---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug"

const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const last_posts = posts.slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-3xl w-full font-bold mb-5">About Me</div>
    <!-- make a space here-->

    <div class="py-2">
      <text class="text-lg">
        I am a postdoctoral researcher at <a href="https://uni-tuebingen.de/en/research/core-research/cluster-of-excellence-machine-learning/research/research/cluster-research-groups/research-groups/lifelong-reinforcement-learning/", class="na">Lifelong Reinforcement Learning Lab</a> at <a href="https://www.uni-tuebingen.de/en", class="na">University of Tübingen</a>, Germany. Previously, I was a PhD student at <a hre="https://is.mpg.de", class="na">Max-Planck-Institute for Intelligent Systems</a>
        and University of Tuebingen. I am an information theorist and
        computer scientist, working on a variety of topics in machine learning. I have done my masters at <a href="https://sharif.edu", class="na">Sharif University of Technology</a> in Iran in 2019. 
        <br />
        During my masters, I did a research internship at <a href="https://www.nycu.edu.tw/nycu/en/index", class="na">National Yang Ming Chiao Tung University</a> in Taiwan.
        <br />
        Besides my academic life, I am interested in Persian poetry, reading and writing fictional stories, and talking philosophy.
        If you want to chat, just drop me an <a href="mailto:amin.ch90@gmail.com", class="na">email</a> or find me on <a href="https://twitter.com/charusaie", class="na">Twitter</a>. You can
        find me on <a href="https://www.github.com/AminChrs", class="na">GitHub</a> and <a href="https://www.linkedin.com/in/mohammad-amin-charusaie-a026824b/", class="na">LinkedIn</a>, and <a href="https://scholar.google.com/citations?user=r2WtymQAAAAJ&hl=en", class="na">Google Scholar</a> too.
    <style>
        .red-text {
            color: red;
            font-size: 1.2em;
        }
                .icon {
            margin-right: 5px;
            margin-left: 5px;
        }
    </style>
    <p>
    <text class="red-text"><span class="icon">🔔</span>I am currently on the academic and industry job market. Feel free to contact me if you know of any relevant position.<span class="icon">🔔</span></text>
    </p>
      </text>
    </div>
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-5">Machine Learning Projects</div>
  </div>
  <HorizontalCard
    title="A Unifying Post-Processing Framework for Multi-Objective Learn-to-Defer Problems"
    badge="NeurIPS 2024"
    img="/uni.webp"
    desc="This paper introduces a unifying framework for constrained optimization problems, mainly for classification and learn-to-defer tasks. This is a generalization of Neyman-Pearson lemma and counters the regularization paradigm."
    url="https://proceedings.neurips.cc/paper_files/paper/2024/file/2a5a41a536d3ada8fbf61a9d6fbf18d2-Paper-Conference.pdf"
  />
  <style>
    .glow-button {
        border: 1.5px solid black;
        /* padding: 10px; */
        background: white;
        color: black;
        transition: 0.3s;
    }
    .glow-button:hover {
        box-shadow: 0 0 10px black;
    }
</style>
