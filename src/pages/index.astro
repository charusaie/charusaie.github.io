  <div class="divider my-0"></div>
  <HorizontalCard
    title="Hermite Polynomial Features for Private Data Generation"
    badge="ICML 2022 (Spotlight)"
    img="/DPHP.webp"
    desc="In this paper, we designed an alternative to random features to generate more efficient representations of a dataset that are privacy-preserving, while maintain the quality of the instances."
    url="https://proceedings.mlr.press/v162/vinaroz22a/vinaroz22a.pdf"
  />
  <a href="https://github.com/ParkLabML/DP-HP" target="_blank">
  <button class="glow-button"> &nbsp; Code &nbsp; </button>
</a>
