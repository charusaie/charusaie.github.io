  <button class="glow-button"> &nbsp; Poster &nbsp; </button>
</a>
  <div class="divider my-0"></div>
  <HorizontalCard
    title="Sample Efficient Learning of Predictors that Complement Humans"
    badge="ICML 2022 (Spotlight)"
    img="/Eff.webp"
    desc="In here, we provide the first theoretical results on the joint learning of classifier and rejector, and design an active learning algorithm to achieve this. We further introduce a set of surrogate losses to enable learn-to-defer training for neural networks."
    url="https://proceedings.mlr.press/v162/charusaie22a/charusaie22a.pdf"
  />
  <a href="https://github.com/clinicalml/active_learn_to_defer" target="_blank">
    <button class="glow-button"> &nbsp; Code &nbsp; </button>
  </a>
  <a href="https://github.com/charusaie/charusaie.github.io/tree/gh-pages/slides/Slides-Pred.pdf" target="_blank">
    <button class="glow-button"> &nbsp; Slides &nbsp; </button>
  </a>
  <a href="https://github.com/charusaie/charusaie.github.io/tree/gh-pages/slides/Poster-Pred.png" target="_blank">
